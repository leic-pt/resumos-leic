---
import ExternalLink from './ExternalLink.astro';
import GitHubIcon from './icons/GitHub';
import { siteConfig } from '../config';
import './Footer.css';

const { githubLink, contributionGuideLink, contributorsLink, owner } = siteConfig.footer;
---

<footer>
  <hr />
  <div class='footer-attributions'>
    <span>
      <ExternalLink href={githubLink}>Website</ExternalLink>
      <GitHubIcon className='footer-github-logo' />
      {' by '}
      <ExternalLink href={owner.website}>
        {owner.name}
      </ExternalLink>
      {' with ❤️'}
    </span>
    <span>
      <ExternalLink href={contributionGuideLink}>How to Contribute</ExternalLink>
    </span>
    <span>
      {'Content by '}
      <ExternalLink href={contributorsLink}>many awesome contributors</ExternalLink>
    </span>
  </div>
</footer>

---
import 'katex/dist/katex.min.css';
import 'prismjs/themes/prism-tomorrow.css';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import ArticleNavigation from '../components/ArticleNavigation.astro';
import CourseContents from '../components/CourseContents.astro';
import ExternalLink from '../components/ExternalLink.astro';
import Edit from '../components/icons/Edit';
import CalculatorHost from '../components/md-tools/CalculatorHost';
import { getAllPages, getSidebarSections, getSubjectPages } from '../lib/pages';
import { siteConfig } from '../config';

export async function getStaticPaths() {
  const pages = await getAllPages();
  return pages
    .filter((page) => page.data.path && page.data.path !== '/')
    .map((page) => ({
      params: { slug: page.data.path.replace(/^\//, '') },
      props: { entry: page },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const pages = await getAllPages();
const homepage = pages.find((page) => page.data.path === '/');
const subject = entry.data.path.split('/')[1];
const subjectPages = getSubjectPages(pages, subject);
const sections = getSidebarSections(subjectPages, siteConfig.sidebarSections);
const orderedLinks = sections.flatMap((section) => section.links);
const currentIndex = orderedLinks.findIndex(({ path }) => path === entry.data.path);
const previous = currentIndex > 0 ? orderedLinks[currentIndex - 1] : undefined;
const next =
  currentIndex >= 0 && currentIndex < orderedLinks.length - 1
    ? orderedLinks[currentIndex + 1]
    : undefined;
const sectionTitle = subjectPages.find((page) => page.data.type === 'topLevelPage')?.data.title;
const githubLink = entry.filePath
  ? `${siteConfig.footer.githubLink}/edit/master/${entry.filePath.replace(/\\/g, '/')}`
  : undefined;
const componentNames = entry.data.components ?? [];
---

<BaseLayout title={entry.data.title} description={entry.data.description ?? undefined}>
  <div class='page-container'>
    <div class='sidebar-mask'></div>
    <Navbar toggleSidebar section={sectionTitle} years={homepage?.data.years} />
    <Sidebar sections={sections} currentPath={entry.data.path} />
    <div class='main-container'>
      <main id='main-content'>
        {
          githubLink && (
            <ExternalLink href={githubLink} class='edit-link'>
              <Edit /> Edit page
            </ExternalLink>
          )
        }
        <div class='content'>
          <Content />
        </div>
        {
          entry.data.type === 'topLevelPage' && (
            <CourseContents sections={sections} currentPath={entry.data.path} />
          )
        }
        {componentNames.map((name) => <CalculatorHost name={name} client:visible />)}
        {
          entry.data.type !== 'topLevelPage' && (previous || next) && (
            <ArticleNavigation previous={previous} next={next} />
          )
        }
      </main>
      <div style='flex-grow: 1'></div>
      <Footer />
    </div>
  </div>
</BaseLayout>
<script>
  import '../scripts/sidebar';
  import '../scripts/mermaid';
  import '../scripts/tabs';
</script>
